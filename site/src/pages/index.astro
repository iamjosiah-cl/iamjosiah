---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/iamjosiahiconfondo.png';
import { profile, socials } from '../data/site';

interface LinkItem {
  title: string;
  subtitle: string;
  href: string;
  icon: string;
  color: string;
  external?: boolean;
  download?: boolean;
}

const groups: { title: string; links: LinkItem[] }[] = [
  {
    title: 'Mis Proyectos',
    links: [
      { title: 'Mis Proyectos', subtitle: 'Documentación y detalles independientes', href: '/proyectos/', icon: 'folder', color: '#6366F1' },
      { title: 'Curriculum Web', subtitle: 'Ver mi experiencia y formación interactiva', href: '/portafolio/', icon: 'file', color: '#8B5CF6' },
      { title: 'Descargar CV', subtitle: `Versión en PDF para impresión · Actualizado el ${profile.cvUpdated}`, href: profile.cvUrl, icon: 'download', color: '#10B981', download: true },
    ],
  },
  {
    title: 'Zona de Juegos',
    links: [
      { title: 'Puzzles', subtitle: 'Ver todos los desafíos disponibles', href: '/juegos/', icon: 'gamepad', color: '#14B8A6' },
    ],
  },
  {
    title: 'Mis Redes',
    links: [
      { title: 'Instagram', subtitle: 'Contenido de mi vida personal', href: 'https://www.instagram.com/iamjosiah.cl/', icon: 'instagram', color: '#F472B6', external: true },
      { title: 'YouTube', subtitle: 'Videos de los proyectos en los que he estado', href: 'https://www.youtube.com/@iamjosiah-cl', icon: 'youtube', color: '#38BDF8', external: true },
    ],
  },
];
---

<Base title="I Am Josiah | Josías Jofré - Programador Web y Editor" path="/">
  <main class="wrap">
    <article class="profile card reveal">
      <div class="banner" aria-hidden="true"></div>
      <div class="avatar">
        <Image src={avatar} alt="Foto de Josías Jofré" width={112} height={112} densities={[1, 2]} loading="eager" fetchpriority="high" />
      </div>

      <h1 class="handle">{profile.handle}</h1>
      <p class="tagline">{profile.tagline}</p>

      <ul class="socials" aria-label="Redes sociales">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} size={20} />
            </a>
          </li>
        ))}
      </ul>

      {groups.map((g) => (
        <section class="group">
          <h2>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a
                  class="link"
                  href={l.href}
                  {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  {...(l.download ? { download: '' } : {})}
                >
                  <span class="link-icon" style={`--c:${l.color}`}><Icon name={l.icon} size={18} /></span>
                  <span class="link-text">
                    <strong>{l.title}</strong>
                    <span>{l.subtitle}</span>
                  </span>
                  <Icon name={l.external ? 'external' : l.download ? 'download' : 'arrow-right'} size={18} class="link-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <footer class="foot">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>© {new Date().getFullYear()} I Am Josiah</span>
      </footer>
    </article>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100dvh;
    display: grid;
    place-items: start center;
    padding: 32px 16px 48px;
  }
  @media (min-width: 640px) { .wrap { padding-top: 56px; } }

  .profile {
    width: 100%;
    max-width: 560px;
    padding: 20px 20px 24px;
    text-align: center;
    border-radius: 24px;
  }
  @media (min-width: 640px) { .profile { padding: 24px 28px 28px; } }

  .banner {
    height: 112px;
    border-radius: 16px;
    background:
      radial-gradient(circle at 20% 20%, rgb(255 255 255 / 0.25), transparent 40%),
      linear-gradient(135deg, #2563eb, #22d3ee 55%, #8b5cf6);
  }

  .avatar {
    width: 120px; height: 120px;
    margin: -60px auto 0;
    padding: 4px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 0 4px var(--bg-elev), 0 12px 40px -8px rgb(34 211 238 / 0.45);
  }
  .avatar :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }

  .handle { margin-top: 18px; font-size: 1.5rem; font-weight: 800; }
  .tagline { margin-top: 4px; color: var(--text-muted); font-size: 0.95rem; }

  .socials {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;
    margin-top: 18px;
  }
  .socials a {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 12px;
    color: var(--text-muted);
    transition: color 0.15s, background-color 0.15s;
  }
  .socials a:hover { color: var(--text); background: rgb(255 255 255 / 0.07); }

  .group { margin-top: 26px; text-align: left; }
  .group h2 {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 4px 10px;
  }
  .group ul { display: grid; gap: 10px; }

  .link {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.035);
    border: 1px solid var(--border);
    transition: border-color 0.15s, background-color 0.15s, transform 0.15s var(--ease);
  }
  .link:hover { border-color: var(--border-accent); background: rgb(255 255 255 / 0.06); transform: translateX(2px); }
  .link-icon {
    display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 12px;
    color: #fff;
    background: var(--c);
    flex-shrink: 0;
  }
  .link-text { display: grid; flex: 1; min-width: 0; }
  .link-text strong { font-weight: 600; }
  .link-text span { color: var(--text-muted); font-size: 0.85rem; line-height: 1.4; }
  .link :global(.link-arrow) { color: var(--text-dim); transition: color 0.15s; flex-shrink: 0; }
  .link:hover :global(.link-arrow) { color: var(--accent); }

  .foot {
    display: grid; gap: 2px;
    margin-top: 28px;
    color: var(--text-dim); font-size: 0.85rem;
  }
  .foot a:hover { color: var(--accent); }
</style>

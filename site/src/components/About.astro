---
import Icon from './Icon.astro';
import { about } from '../data/site';
---

<section id="sobre-mi" class="section container">
  <div class="section-head reveal">
    <h2>Sobre Mí</h2>
    <div class="accent-bar"></div>
  </div>

  <div class="text reveal">
    {about.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <ul class="features">
    {about.features.map((f, i) => (
      <li class="card card-hover reveal" style={`--d:${i * 50}ms`}>
        <span class="icon-box"><Icon name={f.icon} size={22} /></span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .text {
    display: grid; gap: 18px;
    max-width: 72ch; margin: 0 auto 48px;
    color: var(--text-muted); font-size: 1.06rem; line-height: 1.8;
  }
  .features {
    display: grid; gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .features li { padding: 24px; display: grid; gap: 12px; align-content: start; }
  h3 { font-size: 1.06rem; font-weight: 700; margin-top: 4px; }
  .features p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.6; }
</style>

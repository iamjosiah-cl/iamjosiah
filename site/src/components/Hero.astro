---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/iamjosiahiconfondo.png';
import { profile } from '../data/site';
---

<section id="inicio" class="hero container">
  <div class="hero-text">
    <span class="eyebrow"><Icon name="terminal" size={14} /> {profile.role}</span>
    <h1>
      {profile.name} <span class="gradient-text">{profile.lastName}</span>
    </h1>
    <p class="lead">{profile.heroText}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#contacto"><Icon name="mail" size={18} /> Contáctame</a>
      <a class="btn btn-tonal" href={profile.cvUrl} download><Icon name="download" size={18} /> Descargar CV</a>
      <a class="btn btn-outline" href="#sobre-mi">Ver Curriculum</a>
      <a class="btn btn-ghost" href="/"><Icon name="arrow-left" size={18} /> Volver a beacon</a>
    </div>
  </div>

  <div class="hero-avatar">
    <div class="ring">
      <Image src={avatar} alt="Foto de Josías Jofré" width={240} height={240} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 40px;
    align-items: center;
    padding-block: 48px 64px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
      min-height: calc(100dvh - var(--nav-h));
      padding-block: 64px;
    }
  }

  .hero-text { display: grid; justify-items: start; gap: 22px; }
  h1 {
    font-size: clamp(2.6rem, 1.6rem + 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .lead { font-size: 1.12rem; color: var(--text-muted); max-width: 54ch; line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .hero-avatar { display: grid; place-items: center; order: -1; }
  @media (min-width: 900px) { .hero-avatar { order: 0; } }

  .ring {
    width: clamp(160px, 30vw, 280px);
    aspect-ratio: 1;
    padding: 5px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 0 6px var(--bg), 0 30px 80px -20px rgb(34 211 238 / 0.45);
  }
  .ring :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
</style>

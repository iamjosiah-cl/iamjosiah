---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

interface Props {
  /** Usar h1 en la página independiente /proyectos. */
  asPage?: boolean;
}
const { asPage = false } = Astro.props;
const Heading = asPage ? 'h1' : 'h2';
---

<section id="proyectos" class="section container">
  <div class="section-head reveal">
    <Heading>Proyectos Destacados</Heading>
    <div class="accent-bar"></div>
    <p>Una selección de los proyectos en los que he trabajado durante mi carrera.</p>
  </div>

  <div class="grid">
    {projects.map((p, i) => <ProjectCard project={p} delay={(i % 4) * 50} />)}
  </div>
</section>

<style>
  .grid {
    display: grid; gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
  }
  h1 { font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem); font-weight: 800; }
</style>
